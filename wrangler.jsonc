// Configuration Cloudflare (hébergement statique du site GPBC)
{
  "name": "gpbc-app",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  // Adresse de test fournie par Cloudflare (xxx.workers.dev)
  "workers_dev": true
  // Le domaine gpbc-graveson.fr est rattaché via le tableau de bord Cloudflare
  // (Worker > Settings > Domains & Routes > Add > Custom Domain)
}
